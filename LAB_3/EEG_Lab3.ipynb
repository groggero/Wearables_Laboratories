    "## 16 Self-implemented LDA"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "9e194ba0",
   "metadata": {},
   "outputs": [],
   "source": [
    "def LDA(x_train, y_train):\n",
    "\n",
    "    # Separate the two classes\n",
    "    classes = np.unique(y_train)\n",
    "\n",
    "    X1 = x_train[y_train == classes[0]]\n",
    "    X2 = x_train[y_train == classes[1]]\n",
    "\n",
    "    # Compute class means\n",
    "    mu1 = np.mean(X1, axis=0)\n",
    "    mu2 = np.mean(X2, axis=0)\n",
    "\n",
    "    # Within-class scatter matrix\n",
    "    S_W = ((X1 - mu1).T @ (X1 - mu1)\n",
    "         + (X2 - mu2).T @ (X2 - mu2))\n",
    "\n",
    "    # Between-class scatter matrix\n",
    "    mean_diff = mu1 - mu2\n",
    "    S_B = np.outer(mean_diff, mean_diff)\n",
    "\n",
    "    # Eigenvalue decomposition\n",
    "    eigenvalues, eigenvectors = np.linalg.eig(\n",
    "        np.linalg.pinv(S_W) @ S_B\n",
    "    )\n",
    "\n",
    "    # Sort eigenvalues in descending order\n",
    "    idx = np.argsort(eigenvalues.real)[::-1]\n",
    "\n",
    "    # Select the most discriminative eigenvector\n",
    "    w_lda = eigenvectors[:, idx[0]].real\n",
    "\n",
    "    # Normalize the LDA weights\n",
    "    w_lda /= np.linalg.norm(w_lda)\n",
    "\n",
    "    return w_lda"

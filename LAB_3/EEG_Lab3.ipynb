   "source": "# ---------- Loading ----------\ndef load_data(path='data.pkl', verbose=True):\n    \"\"\"Load the lab pickle file (a dict) and optionally print the shape of every entry.\"\"\"\n    with open(path, 'rb') as f:\n        data = pickle.load(f)\n    if verbose:\n        for key, value in data.items():\n            print(f'{key:20s} shape={np.shape(value)}')\n    return data\n\n\ndef get_trial(data, trial):\n    \"\"\"Return the EEG and IMU arrays of one trial (1 or 2) under short, uniform names.\"\"\"\n    return {\n        'eeg':      data[f'eeg_data{trial}'],        # (n_samples, 8)\n        'eeg_time': data[f'eeg_timestamps{trial}'],  # (n_samples,)  500 Hz\n        'imu':      data[f'imu_acc{trial}'],         # (n_samples, 3) irregular sampling\n        'imu_time': data[f'imu_time{trial}'],        # (n_samples,)\n    }\n\n\n# ---------- Plotting ----------\nEVENT_COLORS = ['red', 'green', 'purple', 'orange', 'brown', 'magenta']\n\n\ndef plot_signals(time, signals, title='', ylabel='', channel_names=None, separate=False,\n                 events=None, event_labels=None, interactive=False, xlim=None, show=True):\n    \"\"\"\n    Plot a (multichannel) signal against time. Works for raw EEG, filtered EEG, IMU, ...\n\n    time          : (n_samples,) time axis in seconds\n    signals       : (n_samples, n_channels) or (n_samples,) array\n    channel_names : names for legend / subplot labels (default 'Ch 1', 'Ch 2', ...)\n    separate      : True  -> one subplot per channel with a shared time axis (good for EEG)\n                    False -> all channels on one axis (good for IMU x/y/z)\n    events        : optional event times in seconds, drawn as dashed vertical lines\n    event_labels  : optional label per event (e.g. 'writing', 'eating');\n                    events with the same label share a colour\n    interactive   : True  -> plotly (zoom + cursor read-out, use this for labelling)\n                    False -> matplotlib (static, use this for the report)\n    xlim          : optional (t_start, t_end) to zoom in\n    show          : display the figure; the figure is returned either way\n    \"\"\"\n    time = np.asarray(time)\n    signals = np.asarray(signals)\n    if signals.ndim == 1:\n        signals = signals[:, None]\n    if signals.shape[0] != time.shape[0]:\n        raise ValueError(f'time has {time.shape[0]} samples but signals has {signals.shape[0]}')\n    n_ch = signals.shape[1]\n    if channel_names is None:\n        channel_names = [f'Ch {i + 1}' for i in range(n_ch)]\n\n    events = [] if events is None else list(events)\n    if event_labels is None:\n        event_labels = [None] * len(events)\n    if len(event_labels) != len(events):\n        raise ValueError('event_labels must have one entry per event')\n    unique_labels = list(dict.fromkeys(event_labels))\n    color_of = {lab: ('black' if lab is None else EVENT_COLORS[i % len(EVENT_COLORS)])\n                for i, lab in enumerate(unique_labels)}\n\n    n_rows = n_ch if separate else 1\n\n    if interactive:\n        fig = make_subplots(rows=n_rows, cols=1, shared_xaxes=True, vertical_spacing=0.01)\n        for i in range(n_ch):\n            fig.add_trace(go.Scattergl(x=time, y=signals[:, i], mode='lines',\n                                       name=channel_names[i], line=dict(width=1)),\n                          row=i + 1 if separate else 1, col=1)\n            if separate:\n                fig.update_yaxes(title_text=channel_names[i], row=i + 1, col=1)\n        for t, lab in zip(events, event_labels):\n            fig.add_vline(x=t, line=dict(color=color_of[lab], dash='dash', width=1))\n        for lab in unique_labels:  # legend entries for the event lines\n            if lab is not None:\n                fig.add_trace(go.Scatter(x=[None], y=[None], mode='lines', name=lab,\n                                         line=dict(color=color_of[lab], dash='dash')))\n        if not separate:\n            fig.update_yaxes(title_text=ylabel)\n        fig.update_xaxes(title_text='Time (s)', row=n_rows, col=1)\n        if xlim is not None:\n            fig.update_xaxes(range=list(xlim))\n        fig.update_layout(title=title, height=180 * n_rows + 150 if separate else 450)\n        if show:\n            fig.show()\n        return fig\n\n    fig, axes = plt.subplots(n_rows, 1, sharex=True, squeeze=False,\n                             figsize=(14, 1.5 * n_rows + 1.5 if separate else 4.5))\n    axes = axes[:, 0]\n    for i in range(n_ch):\n        ax = axes[i] if separate else axes[0]\n        ax.plot(time, signals[:, i], lw=0.6, label=channel_names[i])\n        if separate:\n            ax.set_ylabel(channel_names[i])\n    for ax in axes:\n        for t, lab in zip(events, event_labels):\n            ax.axvline(t, color=color_of[lab], ls='--', lw=1)\n    handles = [plt.Line2D([], [], color=color_of[lab], ls='--', label=lab)\n               for lab in unique_labels if lab is not None]\n    if separate:\n        fig.supylabel(ylabel)\n        if handles:\n            axes[0].legend(handles=handles, loc='upper right')\n    else:\n        axes[0].set_ylabel(ylabel)\n        axes[0].legend(handles=axes[0].get_lines()[:n_ch] + handles, loc='upper right')\n    axes[-1].set_xlabel('Time (s)')\n    if xlim is not None:\n        axes[-1].set_xlim(xlim)\n    fig.suptitle(title)\n    fig.tight_layout()\n    if show:\n        plt.show()\n    return fig\n\n\ndef plot_trial(data, trial, eeg=None, eeg_title='EEG', interactive=False, **kwargs):\n    \"\"\"\n    Lab task 4/5: plot the EEG (one subplot per channel) and the IMU (x/y/z on one axis) of a trial.\n    Pass `eeg` to plot e.g. the filtered EEG instead of the raw data.\n    Extra keyword arguments (events, event_labels, xlim, ...) are forwarded to plot_signals.\n    \"\"\"\n    d = get_trial(data, trial)\n    eeg = d['eeg'] if eeg is None else eeg\n    fig_eeg = plot_signals(d['eeg_time'], eeg, title=f'{eeg_title} - trial {trial}',\n                           ylabel='Amplitude', separate=True, interactive=interactive, **kwargs)\n    fig_imu = plot_signals(d['imu_time'], d['imu'], title=f'IMU acceleration - trial {trial}',\n                           ylabel='Acceleration (g)', channel_names=['x', 'y', 'z'],\n                           interactive=interactive, **kwargs)\n    return fig_eeg, fig_imu\n",

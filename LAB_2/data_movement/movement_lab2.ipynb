    "    columns=[\"Quadriceps RMS\", \"Calf RMS\"]\n",
    ")\n",
    "df_rms[\"Activity\"] = train_labels_all\n",
    "\n",
    "# Match the first Q2 plot's sample interval, accounting for the RMS window.\n",
    "activity_ids = [0, 1, 3, 4, 5]\n",
    "rms_start = max(0, n_samples - window_size)\n",
    "rms_stop = max(0, n_samples * 2 - window_size)\n",
    "rms_short = [\n",
    "    df_rms.loc[df_rms[\"Activity\"] == activity_id].iloc[rms_start:rms_stop]\n",
    "    for activity_id in activity_ids\n",
    "]\n",
    "df_rms_all = pd.concat(rms_short, ignore_index=True)\n",
    "rms_lengths = [len(df) for df in rms_short]\n",
    "rms_boundaries = np.cumsum(rms_lengths)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(15, 6))\n",
    "ax.plot(df_rms_all[\"Quadriceps RMS\"], label=\"Quadriceps RMS\", linewidth=0.8)\n",
    "ax.plot(df_rms_all[\"Calf RMS\"], label=\"Calf RMS\", linewidth=0.8)\n",
    "\n",
    "for boundary in rms_boundaries[:-1]:\n",
    "    ax.axvline(boundary, color=\"black\", linestyle=\"--\")\n",
    "\n",
    "start = 0\n",
    "for name, length in zip(activity_names, rms_lengths):\n",
    "    if length:\n",
    "        ax.text(\n",
    "            start + length / 2, 0.93, name,\n",
    "            transform=ax.get_xaxis_transform(),\n",
    "            ha=\"center\"\n",
    "        )\n",
    "    start += length\n",
    "\n",
    "ax.set_title(\"Extracted EMG RMS Features\")\n",
    "ax.set_xlabel(\"Feature Window Number\")\n",
    "ax.set_ylabel(\"RMS (ADC values)\")\n",
    "ax.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\"\"\"\n"
   ]

    "# Linus changes: swap the order of the columns to match the required order: Quadriceps EMG, Calf EMG, Strain Sensor, Activity\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import scipy.signal as signal\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "cols = [\"Quadriceps EMG\", \"Calf EMG\", \"Strain Sensor\", \"Activity\"]   # required column order\n",
    "emg_cols = [\"Quadriceps EMG\", \"Calf EMG\"]\n",
    "\n",
    "fs = 100 #250 \n",
    "b, a = signal.butter(4, 10, btype=\"low\", fs=fs)\n",
    "\n",
    "# ---------------- Squat (label 1) ----------------\n",
    "df_squat = pd.read_csv(\"ex1.4_squat_10times_2.txt\", header=None)     # header=None: keep first sample\n",
    "df_squat = df_squat.dropna()                                         # remove NaN rows\n",
    "df_squat_4col = np.column_stack((df_squat.iloc[:, [1, 2, 0]], np.ones(df_squat.shape[0])))   # quad, calf, strain\n",
    "df_squat_4col = pd.DataFrame(df_squat_4col, columns=cols)\n",
    "raw_squat = df_squat_4col.copy()                                     # keep raw copy to compare\n",
    "\n",
    "# Plot raw\n",
    "plt.figure(figsize=(10, 4))\n",
    "plt.plot(df_squat_4col.iloc[:, :3], linewidth=0.8)\n",
    "plt.xlabel(\"Sample Number\", fontsize=14)\n",
    "plt.ylabel(\"ADC value\", fontsize=14)\n",
    "plt.title(\"Squat - raw\", fontsize=16)\n",
    "plt.grid(True)\n",
    "plt.ylim(0,500)\n",
    "plt.legend([\"Quadriceps EMG\", \"Calf EMG\", \"Strain Sensor\"], loc=\"upper right\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "df_squat_4col[\"Strain Sensor\"] = signal.filtfilt(b, a, df_squat_4col[\"Strain Sensor\"])\n",
    "df_squat_4col[emg_cols] = df_squat_4col[emg_cols].apply(lambda x: remove_outliers(x, window=50), axis=0)\n",
    "print(\"Squat: rows\", len(df_squat_4col), \"| replaced outliers per channel:\\n\",\n",
    "      (raw_squat[emg_cols] != df_squat_4col[emg_cols]).sum())\n",
    "\n",
    "# Plot cleaned\n",
    "plt.figure(figsize=(10, 4))\n",
    "plt.plot(df_squat_4col.iloc[:, :3], linewidth=0.8)\n",
    "plt.xlabel(\"Sample Number\", fontsize=14)\n",
    "plt.ylabel(\"ADC value\", fontsize=14)\n",
    "plt.title(\"Squat - cleaned\", fontsize=16)\n",
    "plt.ylim(0,500)\n",
    "plt.grid(True)\n",
    "plt.legend([\"Quadriceps EMG\", \"Calf EMG\", \"Strain Sensor\"], loc=\"upper right\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# ---------------- Stand (label 0) ----------------\n",
    "df_stand = pd.read_csv(\"ex1.4_stand_60sec_1.txt\", header=None).dropna()\n",
    "df_stand_4col = np.column_stack((df_stand.iloc[:, [1, 2, 0]], np.zeros(df_stand.shape[0])))\n",
    "df_stand_4col = pd.DataFrame(df_stand_4col, columns=cols)\n",
    "df_stand_4col[\"Strain Sensor\"] = signal.filtfilt(b, a, df_stand_4col[\"Strain Sensor\"])\n",
    "df_stand_4col[emg_cols] = df_stand_4col[emg_cols].apply(lambda x: remove_outliers(x, window=50), axis=0)\n",
    "\n",
    "# ---------------- Toe raise (label 2) ----------------\n",
    "df_toeraise = pd.read_csv(\"ex1.4_toeraise_1.txt\", header=None).dropna()\n",
    "df_toeraise_4col = np.column_stack((df_toeraise.iloc[:, [1, 2, 0]], 2*np.ones(df_toeraise.shape[0])))\n",
    "df_toeraise_4col = pd.DataFrame(df_toeraise_4col, columns=cols)\n",
    "df_toeraise_4col[\"Strain Sensor\"] = signal.filtfilt(b, a, df_toeraise_4col[\"Strain Sensor\"])\n",
    "df_toeraise_4col[emg_cols] = df_toeraise_4col[emg_cols].apply(lambda x: remove_outliers(x, window=50), axis=0)\n",
    "\n",
    "print(df_toeraise_4col)\n",
    "\n",
    "# ---------------- Kick back (label 3) ----------------\n",
    "df_kickback = pd.read_csv(\"ex1.4_kickback_1.txt\", header=None).dropna()\n",
    "df_kickback_4col = np.column_stack((df_kickback.iloc[:, [1, 2, 0]], 3*np.ones(df_kickback.shape[0])))\n",
    "df_kickback_4col = pd.DataFrame(df_kickback_4col, columns=cols)\n",
    "df_kickback_4col[\"Strain Sensor\"] = signal.filtfilt(b, a, df_kickback_4col[\"Strain Sensor\"])\n",
    "df_kickback_4col[emg_cols] = df_kickback_4col[emg_cols].apply(lambda x: remove_outliers(x, window=50), axis=0)\n",
    "\n",
    "# ---------------- Knee raise (label 4) ----------------\n",
    "df_kneeraise = pd.read_csv(\"ex1.4_kneeraise_1.txt\", header=None).dropna()\n",
    "df_kneeraise_4col = np.column_stack((df_kneeraise.iloc[:, [1, 2, 0]], 4*np.ones(df_kneeraise.shape[0])))\n",
    "df_kneeraise_4col = pd.DataFrame(df_kneeraise_4col, columns=cols)\n",
    "df_kneeraise_4col[\"Strain Sensor\"] = signal.filtfilt(b, a, df_kneeraise_4col[\"Strain Sensor\"])\n",
    "df_kneeraise_4col[emg_cols] = df_kneeraise_4col[emg_cols].apply(lambda x: remove_outliers(x, window=50), axis=0)"
   ]

    "def rms(x):\n",
    "    return np.sqrt(np.mean(x**2))\n",
    "\n",
    "def waveformlength(x):\n",
    "    return np.sum(np.abs(np.diff(x)))\n",
    "\n",
    "def aryule(x, order):\n",
    "    \"\"\"\n",
    "    Estimate AR model coefficients using Yule-Walker method\n",
    "    Parameters:\n",
    "    x (array-like): The time series data\n",
    "    order (int): The order of the AR model\n",
    "    Returns:\n",
    "    a: The estimated AR coefficients\n",
    "    \"\"\"\n",
    "    x = np.asarray(x)\n",
    "    n = len(x)\n",
    "    # Compute autocorrelation\n",
    "    r = np.correlate(x, x, mode='full')[n-1:]\n",
    "    r = r[:order+1] / n\n",
    "    # Initialize\n",
    "    a = np.zeros(order)\n",
    "    e = np.zeros(order+1)\n",
    "    k = np.zeros(order)\n",
    "    e[0] = r[0]\n",
    "    # Levinson-Durbin recursion\n",
    "    for i in range(order):\n",
    "        # Compute reflection coefficient\n",
    "        k[i] = (r[i+1] - np.sum(a[:i] * r[i:0:-1])) / e[i]\n",
    "        # Update AR coefficients\n",
    "        a[i] = k[i]\n",
    "        if i > 0:\n",
    "            a[:i] = a[:i] - k[i] * a[i-1::-1]\n",
    "        # Update prediction error\n",
    "        e[i+1] = (1 - k[i]**2) * e[i]\n",
    "    return -a\n",
    "\n",
    "def feature_extraction(df, window_size):\n",
    "    features = []\n",
    "    labels = []\n",
    "    label = df.iloc[0, 3] # Extract label from 4th column, constant per df\n",
    "    for i in range(window_size, len(df), 1): # step +window size give overlap\n",
    "        win = df.iloc[i-window_size:i]\n",
    "        emg1 = win[\"Quadriceps EMG\"].values # Quad\n",
    "        emg2 = win[\"Calf EMG\"].values # Calf\n",
    "        strain = win[\"Strain Sensor\"].values\n",
    "        rms1 = rms(emg1)\n",
    "        wl1 = waveformlength(emg1)\n",
    "        ar1 = aryule(emg1, order=4)\n",
    "        rms2 = rms(emg2)\n",
    "        wl2 = waveformlength(emg2)\n",
    "        ar2 = aryule(emg2, order=4)\n",
    "        rms_strain = rms(strain)\n",
    "        feat = np.concatenate([[rms1, wl1] + list(ar1), [rms2, wl2] + list(ar2), [rms_strain]])\n",
    "        features.append(feat)\n",
    "        labels.append(label)\n",
    "    return np.array(features), np.array(labels)\n"
   ]

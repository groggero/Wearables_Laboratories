    "# Number of samples to plot per activity\n",
    "n_samples = 3000\n",
    "\n",
    "# Selecting only the first 3000 samples from each activity\n",
    "activity_short = [df.iloc[n_samples:n_samples*2] for df in activity_frames]\n",
    "\n",
    "# Concatenate\n",
    "df_all = pd.concat(activity_short, ignore_index=True)\n",
    "\n",
    "# Calculate boundaries based on actual selected lengths\n",
    "lengths = [len(df) for df in activity_short]\n",
    "boundaries = np.cumsum(lengths)\n",
    "\n",
    "# Plot\n",
    "fig, ax = plt.subplots(figsize=(15, 6))\n",
    "\n",
    "ax.plot(df_all[\"Quadriceps EMG\"], label=\"Quadriceps\", linewidth=0.8)\n",
    "ax.plot(df_all[\"Calf EMG\"], label=\"Calf\", linewidth=0.8)\n",
    "\n",
    "# Vertical separation lines\n",
    "for boundary in boundaries[:-1]:\n",
    "    ax.axvline(boundary, color=\"black\", linestyle=\"--\")\n",
    "\n",
    "# Activity labels\n",
    "start = 0\n",
    "for name, length in zip(activity_names, lengths):\n",
    "    midpoint = start + length / 2\n",
    "    ax.text(\n",
    "        midpoint, 0.93, name,\n",
    "        transform=ax.get_xaxis_transform(),\n",
    "        ha=\"center\"\n",
    "    )\n",
    "    start += length\n",
    "\n",
    "ax.set_title(\"EMG Signals\")\n",
    "ax.set_xlabel(\"Sample Number\")\n",
    "ax.set_ylabel(\"ADC Values\")\n",
    "ax.legend()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"

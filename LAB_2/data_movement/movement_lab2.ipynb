    "def remove_outliers(s, window, thresh=2.5):\n",
    "    # Calculate rolling mean and standard deviation over the specified window\n",
    "    roll = s.rolling(window=window, min_periods=1, center=True)\n",
    "    avg = roll.mean() # Rolling mean\n",
    "    std = roll.std(ddof=0) # Rolling standard deviation (with N as denominator)\n",
    "    # Calculate z-scores by subtracting the rolling mean and dividing by rolling std\n",
    "    z = s.sub(avg).div(std)\n",
    "    # Create a mask identifying values within the acceptable z-score threshold\n",
    "    m = z.between(-thresh, thresh)\n",
    "    # Replace outliers (values outside threshold) with the rolling mean\n",
    "    return s.where(m, avg)"
   ]
